export function calculateLeadTemp(lead) \{\
  let score = 0;\
  const mins = (new Date() - new Date(lead.last_message_at)) / (1000 * 60);\
  if (mins <= 15) score += 40;\
  else if (mins <= 120) score += 30;\
  else if (mins <= 1440) score += 15;\
\
  const msgCount = lead.messages_count || 1;\
  score += Math.min(msgCount * 5, 25);\
\
  const keywords = ['precio', 'costo', 'agendar', 'cita', 'disponible', 'pago'];\
  const text = (lead.last_message || '').toLowerCase();\
  if (keywords.some(kw => text.includes(kw))) score += 25;\
\
  if (score >= 65) return \{ label: 'Hirviendo', icon: Flame, score, badge: 'bg-gradient-to-r from-amber-500/20 to-rose-500/20 border-rose-500/40 text-rose-300' \};\
